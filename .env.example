# Ambiente
APP_ENV=dev

# Execução
BROWSER_HEADLESS=false
RESULTS_DIR=results

# Fake Name Generator
FAKE_NAME_URL=https://www.fakenamegenerator.com/gen-random-br-br.php
FAKE_NAME_TIMEOUT_MS=15000

# Sauce Demo
SAUCE_DEMO_URL=https://www.saucedemo.com/
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
SAUCE_PRODUCTS_TIMEOUT_MS=15000
SAUCE_PRODUCTS_RENDER_WAIT_SECONDS=1

# Fakturama
FAKTURAMA_EXE=C:\Program Files\Fakturama2\Fakturama.exe

# Automação visual / tempos de espera
IMAGE_CONFIDENCE=0.80
IMAGE_TIMEOUT_SECONDS=180
IMAGE_POLL_INTERVAL_SECONDS=0.5
FAKTURAMA_AFTER_SAVE_WAIT_SECONDS=0.5
FAKTURAMA_CLOSE_WAIT_SECONDS=1
EVIDENCE_VIEW_WAIT_SECONDS=1
FIELD_CLICK_OFFSET_X=10

# Validação visual de foco
FOCUS_AFTER_CLICK_WAIT_SECONDS=0.1
FOCUS_COLOR_TOLERANCE=12
FOCUS_MIN_MATCH_RATIO=0.60
FOCUS_CLICK_MAX_ATTEMPTS=2
